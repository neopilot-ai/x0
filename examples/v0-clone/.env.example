# Shared v0 API key for both apps. Optional: leave empty to use the browser
# API-key dialog. Format: v1:<teamId>:<token>. Set the same value on both apps.
V0_API_KEY=

# Web app -> preview proxy origin.
# Local default: http://localhost:3001. Required in production unless the
# preview proxy is linked as a Vercel Related Project.
V0_PREVIEW_PROXY_URL=

# Preview proxy -> web app origin.
# Local default: http://localhost:3000. Required in production unless the web
# app is linked as a Vercel Related Project.
V0_CLONE_ORIGIN=
